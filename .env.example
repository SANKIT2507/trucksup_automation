# Copy this file to .env and fill in your values. Never commit .env.

# ── Device and Appium ──────────────────────────────────────────
# Device id from 'adb devices'
DEVICE_NAME=
# Settings > About Phone > Android Version
PLATFORM_VERSION=15
APPIUM_SERVER_URL=http://localhost:4723

# ── Shared test data ───────────────────────────────────────────
TEST_FULL_NAME=Test User
# 12-digit Aadhaar used for DigiLocker (the test also asks at start; Enter = this value)
TEST_AADHAAR_NUMBER=
TEST_STREET_VILLAGE=Pilkhuwa

# ── Truck Supplier test (test_new_user_onboarding) ─────────────
TEST_MOBILE_NUMBER=
TEST_OTP=
TEST_REFERRAL_CODE=
SELECT_PROFILE_TYPE=Truck Supplier
# Must be a real number the TrucksUp server can verify
TEST_VEHICLE_NUMBER=
TEST_LANE_FROM=Delhi
TEST_LANE_TO=Mumbai

# ── Business Associate test (test_business_associate_onboarding)
# Needs an unregistered number. Empty OTP = test waits for you to enter it.
BA_MOBILE_NUMBER=
BA_OTP=
BA_FIRM_NAME=Test Firm
BA_ADDRESS=Main Road, Pilkhuwa
BA_PINCODE=245304

# ── TrucksHub test (test_truckshub_onboarding) ─────────────────
# Needs an unregistered number. Empty OTP = test waits for you to enter it.
TH_MOBILE_NUMBER=
TH_OTP=
